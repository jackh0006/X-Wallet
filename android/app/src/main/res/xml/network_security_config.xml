<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- System CAs only. User-installed CAs are not trusted, so a malicious
         local proxy cannot transparently intercept wallet traffic. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">bsc-dataseed.bnbchain.org</domain>
        <domain includeSubdomains="true">bsc-dataseed-public.bnbchain.org</domain>
        <domain includeSubdomains="true">bsc-dataseed.nariox.org</domain>
        <domain includeSubdomains="true">bsc-rpc.publicnode.com</domain>
        <domain includeSubdomains="true">api.bscscan.com</domain>
        <domain includeSubdomains="true">api-testnet.bscscan.com</domain>
        <domain includeSubdomains="true">api.coingecko.com</domain>
        <domain includeSubdomains="true">api.ipify.org</domain>
    </domain-config>
</network-security-config>
