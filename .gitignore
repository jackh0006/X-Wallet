# Miscellaneous
*.class
*.log
*.pyc
*.pyo
*.orig
*.rej
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
__pycache__/
linux/flutter/ephemeral/
android/.gradle/
.gradle/
.pub-cache/
.pub/
/build/
/coverage/

# Independent ethers.js verification workspace (npm artifacts, never committed)
verification/node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/reports/

# Widget Preview related
.widget_preview/

# Release signing material — never commit. Supply via environment; see
# scripts/build-apk.sh.
*.keystore
*.jks
*.p12
*.pfx
key.properties
release-signing/
# Local handoff keys and passwords (backup folder only, never git)
keys/
*.password

# Local build/release output
/dist/
*.apk
*.aab
*.deb
*.tar.gz
*.zip
*.hprof

# Per-build evidence (recorded locally or uploaded by CI); the committed
# source manifest is release/manifest.json, and a published bundle is
# release/evidence.json.
/release/checks.json
/release/artifacts.json
/release/evidence/

# Local secrets and environment files
.env
.env.*
*.pem
*.key
*.crt
*.csr

# Debug/investigation leftovers
*.bak
/test_*.dart
/bin/investigate*.dart
/bin/verify_signature.dart
